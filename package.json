{
  "name": "research-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for AI-powered academic research",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "research-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "gen:tool-docs": "tsx scripts/gen-tool-docs.ts"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "cac": "^6.7.14",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "file-type": "^19.0.0",
    "gpt-tokenizer": "^3.4.0",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "protobufjs", "sharp"]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
