# Research MCP Server — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Core ─────────────────────────────────────────────────────────────────────
MCP_TRANSPORT=http
PORT=3000
DATA_DIR=/data
LOG_LEVEL=info

# ── GROBID ───────────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml; override for a remote GROBID.
GROBID_URL=http://grobid:8070

# ── HTTP security ─────────────────────────────────────────────────────────────
# Uncomment to require "Authorization: Bearer <token>" on all HTTP requests.
# BEARER_TOKEN=change-me-to-something-random

# ── Source API keys (optional — increases rate limits) ───────────────────────
# SEMANTIC_SCHOLAR_API_KEY=
# PUBMED_API_KEY=

# ── Embeddings ───────────────────────────────────────────────────────────────
# Options: local (default, offline), voyage, openai
EMBEDDER=local

# Required when EMBEDDER=voyage:
# VOYAGE_API_KEY=

# Required when EMBEDDER=openai:
# OPENAI_API_KEY=

# Override the embedding model name (leave blank for backend default):
# EMBEDDING_MODEL=
